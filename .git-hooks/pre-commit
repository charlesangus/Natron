#!/bin/bash

export LANG=C

# Mirrors the "format" job in .github/workflows/checks.yml: clang-format on
# changed lines only, via git-clang-format. This hook is advisory, not a
# gate substitute -- the CI "format" check is what's actually required on
# main. If clang-format/git-clang-format isn't installed locally, warn and
# let the commit through rather than blocking on a missing optional tool.

EXTENSIONS="c,cc,cpp,h,hpp,mm"

warn_and_pass() {
	echo "git pre-commit hook:"
	echo "       $1"
	echo "       Skipping the local format check; CI's \"format\" check will still run on the PR."
	exit 0
}

if ! command -v python3 >/dev/null 2>&1; then
	warn_and_pass "python3 not found."
fi

# Prefer the pinned clang-format shipped by the pip "clang-format" package
# (same one CI resolves), so the hook can't silently drift onto a
# differently-versioned clang-format that happens to be on PATH.
CF_BINARY="$(python3 -c 'import clang_format, os; print(os.path.join(os.path.dirname(clang_format.__file__), "data", "bin", "clang-format"))' 2>/dev/null)"
if [ -z "$CF_BINARY" ] || [ ! -x "$CF_BINARY" ]; then
	CF_BINARY="$(command -v clang-format)"
fi
if [ -z "$CF_BINARY" ]; then
	warn_and_pass "Did not find clang-format, please install it before continuing (pip install clang-format, or see tools/ci/local/README.md)."
fi

if ! command -v git-clang-format >/dev/null 2>&1; then
	warn_and_pass "Did not find git-clang-format on PATH (it ships with the pip \"clang-format\" package)."
fi

echo "-----> Checking staged changes with clang-format (changed lines only)"

diff_output="$(git clang-format --binary "$CF_BINARY" --extensions "$EXTENSIONS" --staged --diff)"
status=$?

# git-clang-format exits non-zero when it finds something to fix, and 0
# (printing "no modified files to format" / "clang-format did not modify
# any files") when it doesn't -- same contract the CI job relies on.
if [ $status -ne 0 ]; then
	echo "       Code style error(s) found in staged changes:"
	echo
	echo "$diff_output" | sed 's/^/       /'
	echo
	echo "       Review the diff above, then re-stage the affected files."
	echo "       You can apply clang-format's suggested changes directly with:"
	echo
	echo "       git clang-format --binary $CF_BINARY --extensions $EXTENSIONS --staged"
	exit 1
fi

echo "       clang-format passed"
