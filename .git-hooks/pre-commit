#!/bin/bash

export LANG=C

# Mirrors the "format" job in .github/workflows/checks.yml: clang-format on
# changed lines only, via git-clang-format. Unlike CI, this hook fixes
# formatting in place (re-staging the result) instead of only reporting it,
# so a formatting slip never has to round-trip through a failed CI run.

EXTENSIONS="c,cc,cpp,h,hpp,mm"
PATHSPEC=(-- . ':(exclude)Documentation/templates/')
PIN_VERSION="21.1.8"
PIN_INSTALL_CMD="pip install --user --break-system-packages clang-format==$PIN_VERSION"

indent() {
	local prefix="$1" line
	while IFS= read -r line; do
		printf '%s%s\n' "$prefix" "$line"
	done
}

fail_missing_tool() {
	echo "git pre-commit hook:"
	echo "       $1"
	echo "       Install the pinned version CI uses:"
	echo "       $PIN_INSTALL_CMD"
	exit 1
}

if ! command -v python3 >/dev/null 2>&1; then
	fail_missing_tool "python3 not found."
fi

# Prefer the pinned clang-format shipped by the pip "clang-format" package
# (same one CI resolves), so the hook can't silently drift onto a
# differently-versioned clang-format that happens to be on PATH.
CF_BINARY="$(python3 -c 'import clang_format, os; print(os.path.join(os.path.dirname(clang_format.__file__), "data", "bin", "clang-format"))' 2>/dev/null)"
if [ -z "$CF_BINARY" ] || [ ! -x "$CF_BINARY" ]; then
	CF_BINARY="$(command -v clang-format)"
fi
if [ -z "$CF_BINARY" ]; then
	fail_missing_tool "Did not find the pinned clang-format module."
fi

# A version other than the pin can silently re-stage output CI's clang-format
# rejects, so check the binary directly rather than trusting module/PATH
# resolution to have found the right release.
cf_version="$("$CF_BINARY" --version 2>/dev/null)"
case "$cf_version" in
*" $PIN_VERSION"*) ;;
*)
	fail_missing_tool "Found clang-format \"$cf_version\", not the pinned $PIN_VERSION."
	;;
esac

if ! command -v git-clang-format >/dev/null 2>&1; then
	fail_missing_tool "Did not find git-clang-format on PATH (it ships with the pip \"clang-format\" package)."
fi

matches_ext() {
	local path="$1" ext
	local -a exts
	IFS=',' read -ra exts <<<"$EXTENSIONS"
	for ext in "${exts[@]}"; do
		case "$path" in
		*".$ext") return 0 ;;
		esac
	done
	return 1
}

# git-clang-format silently skips staged paths that git would need to quote
# when listed without -z (non-ASCII, quotes, backslashes), and this hook's
# newline-delimited re-stage parsing below can't represent an embedded
# newline in a path either -- catch both up front so they fail loudly
# instead of being committed unformatted.
bad_paths=""
while IFS= read -r -d '' path; do
	matches_ext "$path" || continue
	case "$path" in
	*$'\n'*)
		bad_paths="$bad_paths
(embedded newline) $path"
		continue
		;;
	esac
	quoted_form="$(git --literal-pathspecs diff --cached --name-only --diff-filter=ACMR -- "$path")"
	case "$quoted_form" in
	\"*)
		bad_paths="$bad_paths
$quoted_form"
		;;
	esac
done < <(git diff --cached --name-only -z --diff-filter=ACMR "${PATHSPEC[@]}")
bad_paths="${bad_paths#$'\n'}"

if [ -n "$bad_paths" ]; then
	echo "git pre-commit hook:"
	echo "       git-clang-format can't safely handle these staged paths (git would"
	echo "       quote them, or they contain a newline), so they can't be auto-formatted:"
	echo
	echo "$bad_paths" | indent "       "
	echo
	echo "       Rename the file(s) to drop the newline/quotes/backslashes/non-ASCII, then commit again."
	exit 1
fi

echo "-----> Formatting staged changes with clang-format (changed lines only)"

apply_output="$(git clang-format --binary "$CF_BINARY" --extensions "$EXTENSIONS" --staged "${PATHSPEC[@]}" 2>&1)"
status=$?

# git-clang-format overloads exit 2 for both "die()" errors and its own
# refusal to apply when a to-be-reformatted file also has unstaged hunks
# (that specific case needs --force, which we never pass since it would
# sweep unrelated unstaged edits into the commit) -- tell those apart by
# the message rather than the exit code alone.
if [ $status -eq 2 ] && echo "$apply_output" | grep -q "unstaged changes"; then
	echo "       Some staged files also have unstaged changes, so they can't be"
	echo "       safely auto-formatted without risking staging unrelated edits:"
	echo
	echo "$apply_output" | indent "       "
	echo
	echo "       Stage or stash the rest of the file, then commit again."
	exit 1
fi

# Exit 1 here means git-clang-format applied changes to the working tree
# (see its "changed files:" list below) -- that's success, not failure.
if [ $status -ne 0 ] && [ $status -ne 1 ]; then
	echo "       git-clang-format failed:"
	echo
	echo "$apply_output" | indent "       "
	exit 1
fi

# With no --diff, git-clang-format prints one of: "no modified files to
# format" / "clang-format did not modify any files" (nothing to re-stage),
# or a "changed files:" list of what it rewrote in the working tree -- the
# latter still needs `git add` since it never touches the real index.
changed_files="$(echo "$apply_output" | sed -n '/^changed files:$/,$ p' | tail -n +2 | sed 's/^    //')"

if [ -z "$changed_files" ]; then
	echo "$apply_output" | indent "       "
	exit 0
fi

echo "       Reformatted:"
echo "$changed_files" | indent "         "
if ! echo "$changed_files" | git --literal-pathspecs add --pathspec-from-file=- --; then
	echo "       Failed to re-stage the reformatted files above; commit aborted."
	exit 1
fi

echo "       Re-staged the formatted files above."
