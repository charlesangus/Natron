<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
    <mime-type type="application/x-natron">
        <comment>Natron Project File</comment>
        <icon name="natronProjectIcon_linux"/>
        <glob-deleteall/>
        <glob pattern="*.ntpz"/>
        <magic priority="60">
            <match type="string" value="PK\003\004" offset="0">
                <match type="string" value="application/vnd.natron.project+zip" offset="39:300"/>
            </match>
        </magic>
    </mime-type>
    <mime-type type="application/x-natron-xml-project">
        <comment>Natron Project File (old XML format)</comment>
        <icon name="natronProjectIcon_linux"/>
        <glob-deleteall/>
        <glob pattern="*.ntp"/>
    </mime-type>
</mime-info>
