     return (_main_window_finder or _find_nuke_main_window)()
 
 
+_row_height_override = None
+_visible_rows_override = None
+
+
+def set_row_metrics(row_height=None, visible_rows=None):
+    """Override the popup's row height (in pixels) and/or how many rows
+    are visible at once, replacing the built-in Nuke-sized defaults
+    (twice the font height, 18 rows). Pass None for either argument to
+    leave that one at its default.
+
+    Lets a host whose own UI uses a different row height size the popup
+    to match, without patching every call site.
+    """
+    global _row_height_override, _visible_rows_override
+    _row_height_override = row_height
+    _visible_rows_override = visible_rows
+
+
+def _row_height(font_h):
+    """Return the configured row height, or twice the given font height
+    (the Nuke default) when none has been registered via set_row_metrics()."""
+    return _row_height_override if _row_height_override is not None else font_h * 2
+
+
+def _visible_rows():
+    """Return the configured number of visible popup rows, or 18 (the
+    Nuke default) when none has been registered via set_row_metrics()."""
+    return _visible_rows_override if _visible_rows_override is not None else 18
+
+
