#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 0.01
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "World"
{
    def Sphere "Plain" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 1
        double3 xformOp:translate = (-1.5, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </World/Looks/Plain>
    }

    def Sphere "Coated" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 1
        double3 xformOp:translate = (1.5, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </World/Looks/Coated>
    }

    def Scope "Looks"
    {
        def Material "Plain"
        {
            token outputs:surface.connect = </World/Looks/Plain/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0, 0, 0)
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "Coated"
        {
            token outputs:surface.connect = </World/Looks/Coated/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0, 0, 0)
                float inputs:roughness = 0.4
                float inputs:clearcoat = 1
                float inputs:clearcoatRoughness = 0.05
                color3f inputs:clearcoatColor = (1, 1, 1)
                token outputs:surface
            }
        }
    }

    def Camera "Cam"
    {
        float focalLength = 35
        float horizontalAperture = 20.955
        float verticalAperture = 20.955
        double3 xformOp:translate = (0, 0, 10)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
