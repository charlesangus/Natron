#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
)

def Xform "World"
{
    # An octahedron Mesh: a UsdGeom Sphere needs USD's implicit-surface scene index to reach Cycles.
    def Mesh "Sphere" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        int[] faceVertexCounts = [3, 3, 3, 3, 3, 3, 3, 3]
        int[] faceVertexIndices = [0, 2, 4, 2, 1, 4, 1, 3, 4, 3, 0, 4, 2, 0, 5, 1, 2, 5, 3, 1, 5, 0, 3, 5]
        rel material:binding = </World/MdlOnly>
        point3f[] points = [(2, 0, 0), (-2, 0, 0), (0, 2, 0), (0, -2, 0), (0, 0, 2), (0, 0, -2)]
    }

    def Material "MdlOnly"
    {
        token outputs:mdl:surface.connect = </World/MdlOnly/Shader.outputs:out>

        def Shader "Shader"
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
            token outputs:out
        }
    }

    def Camera "Cam"
    {
        float focalLength = 35
        float horizontalAperture = 20.955
        float verticalAperture = 20.955
        double3 xformOp:translate = (0, 0, 10)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
