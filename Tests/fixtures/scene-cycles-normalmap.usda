#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 0.01
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "World"
{
    def Mesh "Card" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-2, -2, 0), (2, -2, 0), (2, 2, 0), (-2, 2, 0)]
        texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (
            interpolation = "vertex"
        )
        rel material:binding = </World/Looks/Bumped>
    }

    def DistantLight "Sun"
    {
        # Intensity is radiance, and this light fills only a 0.5 degree disc: this is what it takes to shade the card near 0.4.
        float inputs:intensity = 12000
        float inputs:angle = 0.5
        float3 xformOp:rotateXYZ = (-30, 50, 0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    def Scope "Looks"
    {
        def Material "Bumped"
        {
            token outputs:surface.connect = </World/Looks/Bumped/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.8, 0.8)
                float inputs:roughness = 1
                normal3f inputs:normal.connect = </World/Looks/Bumped/NormalMap.outputs:rgb>
                token outputs:surface
            }

            def Shader "NormalMap"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./scene-cycles-normalmap.png@
                token inputs:sourceColorSpace = "raw"
                float4 inputs:scale = (2, 2, 2, 1)
                float4 inputs:bias = (-1, -1, -1, 0)
                float2 inputs:st.connect = </World/Looks/Bumped/StReader.outputs:result>
                float3 outputs:rgb
            }

            def Shader "StReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
        }
    }

    def Camera "Cam"
    {
        float focalLength = 35
        float horizontalAperture = 20.955
        float verticalAperture = 20.955
        double3 xformOp:translate = (0, 0, 10)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
