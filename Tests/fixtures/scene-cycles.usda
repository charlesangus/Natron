#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 0.01
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "World"
{
    def Cube "Near"
    {
        double size = 2
        color3f[] primvars:displayColor = [(0.8, 0.2, 0.1)]
    }

    def Cube "Far"
    {
        double size = 1
        double3 xformOp:translate = (2.5, 0, -1)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0.1, 0.3, 0.8)]
    }

    def Camera "Cam"
    {
        float focalLength = 35
        float horizontalAperture = 20.955
        float verticalAperture = 20.955
        double3 xformOp:translate = (0, 0, 10)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
