#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 0.01
    timeCodesPerSecond = 24
    upAxis = "Y"
    subLayers = [
        @./scene-moonray-textured.usda@
    ]
)

over "World"
{
    over "Looks"
    {
        over "Textured"
        {
            over "Texture"
            {
                asset inputs:file = @./moonray-texture.tx@
            }
        }
    }
}
