#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
)

class Xform "Cell"
{
    def Cube "Geo"
    {
        double size = 0.5
    }
}

class Xform "Column"
{
    def Xform "Upper" (
        instanceable = true
        references = </Cell>
    )
    {
        double3 xformOp:translate = (0, 1, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "Lower" (
        instanceable = true
        references = </Cell>
    )
    {
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}

def Xform "World"
{
    def Xform "Zed" (
        instanceable = true
        references = </Column>
    )
    {
        double3 xformOp:translate = (-1, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "Alpha" (
        instanceable = true
        references = </Column>
    )
    {
        double3 xformOp:translate = (1, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Camera "Cam"
    {
        double3 xformOp:translate = (0, 0.5, 10)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
