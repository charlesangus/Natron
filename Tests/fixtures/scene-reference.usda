#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 0.01
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "World"
{
    def Cube "Box"
    {
        double size = 2
        color3f[] primvars:displayColor = [(0.8, 0.2, 0.1)]
    }

    def Sphere "Ball"
    {
        double radius = 0.5
        double3 xformOp:translate.timeSamples = {
            1: (3, 0, 0),
            24: (3, 2, 0),
        }
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0.1, 0.3, 0.8)]
    }

    def Camera "Cam"
    {
        float focalLength = 35
        double3 xformOp:translate = (1, 1, 10)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
