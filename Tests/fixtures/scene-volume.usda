#usda 1.0
(
    defaultPrim = "World"
    endTimeCode = 2
    metersPerUnit = 0.01
    startTimeCode = 1
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "World"
{
    def Mesh "Backdrop" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-4, -4, -2), (4, -4, -2), (4, 4, -2), (-4, 4, -2)]
        rel material:binding = </World/Looks/Backdrop>
    }

    def Volume "Smoke"
    {
        rel field:density = </World/Smoke/density>
        rel field:velocity = </World/Smoke/velocity>

        def OpenVDBAsset "density"
        {
            asset filePath.timeSamples = {
                1: @./volume-sphere.0001.vdb@,
                2: @./volume-sphere.0002.vdb@,
            }
            token fieldName = "density"
        }

        def OpenVDBAsset "velocity"
        {
            asset filePath.timeSamples = {
                1: @./volume-sphere.0001.vdb@,
                2: @./volume-sphere.0002.vdb@,
            }
            token fieldName = "velocity"
        }
    }

    def Scope "Looks"
    {
        def Material "Backdrop"
        {
            token outputs:surface.connect = </World/Looks/Backdrop/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0, 0, 0)
                float inputs:roughness = 1
                color3f inputs:emissiveColor = (1, 1, 1)
                token outputs:surface
            }
        }
    }

    def Camera "Cam"
    {
        float focalLength = 50
        float horizontalAperture = 20.955
        float verticalAperture = 20.955
        float2 clippingRange = (0.1, 100)
        double3 xformOp:translate = (0, 0, 10)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
