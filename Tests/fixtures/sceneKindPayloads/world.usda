#usda 1.0
(
    defaultPrim = "World"
)

def Xform "World" (
    kind = "group"
)
{
    def Cube "Ground"
    {
        double size = 0.25
    }

    def Xform "Island" (
        prepend payload = @./island.usda@
    )
    {
    }

    def Xform "Props"
    {
        def Xform "Crate" (
            kind = "component"
            prepend payload = @./crate.usda@
        )
        {
        }
    }
}
