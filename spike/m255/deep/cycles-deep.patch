+HdCyclesRenderBuffer *deepRenderBuffer(const HdCyclesSession *renderParam)
+{
+  for (const HdRenderPassAovBinding &aovBinding : renderParam->GetAovBindingsLocked()) {
+    if (aovBinding.aovName == HdCyclesDeepAovToken()) {
+      return static_cast<HdCyclesRenderBuffer *>(aovBinding.renderBuffer);
+    }
+  }
+  return nullptr;
+}
+
+/* Hands the finished render's deep samples to the cycles:deep render buffer: the samples as its
+ * resource, and their front-to-back composite as its pixels. Only a whole-image tile is handled,
+ * as the deep buffers cover the full frame. */
+void updateDeepBuffer(const HdCyclesSession *renderParam, const OutputDriver::Tile &tile)
+{
+  HdCyclesRenderBuffer *const renderBuffer = deepRenderBuffer(renderParam);
+  DeepOutputDriver *const deep = renderParam->session->get_deep_output_driver();
+  if (!renderBuffer || !deep || !deep->is_enabled()) {
+    return;
+  }
+  const int width = deep->get_width();
+  const int height = deep->get_height();
+  if (tile.offset.x != 0 || tile.offset.y != 0 || tile.size.x != width || tile.size.y != height) {
+    TF_RUNTIME_ERROR("Deep output needs a whole-image tile (%dx%d at %d,%d for a %dx%d image)",
+                     tile.size.x,
+                     tile.size.y,
+                     tile.offset.x,
+                     tile.offset.y,
+                     width,
+                     height);
+    return;
+  }
+
+  const size_t numPixels = size_t(width) * size_t(height);
+  std::vector<float> beauty(numPixels * 4);
+  if (tile.get_pass_pixels(HdAovTokens->color.GetString(), 4, beauty.data())) {
+    deep->set_beauty_buffer(beauty.data(), width, height);
+  }
+  const std::unique_ptr<std::vector<std::vector<blender::DeepSample>>> samples(
+      deep->get_processed_deep_data());
+  if (!samples || samples->size() != numPixels) {
+    TF_RUNTIME_ERROR("Deep output produced no samples");
+    return;
+  }
+
+  auto result = std::make_shared<HydraDeepBuffer>();
+  result->width = width;
+  result->height = height;
+  result->counts.resize(numPixels);
+  result->offsets.resize(numPixels);
+  uint64_t total = 0;
+  for (size_t p = 0; p < numPixels; ++p) {
+    result->offsets[p] = total;
+    result->counts[p] = uint32_t((*samples)[p].size());
+    total += result->counts[p];
+  }
+  result->channelNames = {"R", "G", "B", "A", "Z", "ZBack"};
+  result->channels.assign(result->channelNames.size(), std::vector<float>(total));
+  std::vector<float> flat(numPixels * 4, 0.0f);
+  for (size_t p = 0; p < numPixels; ++p) {
+    float *const out = flat.data() + p * 4;
+    uint64_t i = result->offsets[p];
+    for (const blender::DeepSample &s : (*samples)[p]) {
+      const float values[] = {s.r, s.g, s.b, s.a, s.z, s.z_back};
+      for (size_t c = 0; c < 6; ++c) {
+        result->channels[c][i] = values[c];
+      }
+      ++i;
+      const float t = 1.0f - out[3];
+      out[0] += t * s.r;
+      out[1] += t * s.g;
+      out[2] += t * s.b;
+      out[3] += t * s.a;
+    }
+  }
+
+  renderBuffer->SetResource(VtValue(HydraDeepBufferPtr(std::move(result))));
+  if (renderBuffer->GetFormat() == HdFormatFloat32Vec4) {
+    auto *const data = static_cast<float *>(renderBuffer->Map());
+    if (data && renderBuffer->GetWidth() == unsigned(width) &&
+        renderBuffer->GetHeight() == unsigned(height) &&
+        renderBuffer->GetFormat() == HdFormatFloat32Vec4)
+    {
+      std::copy(flat.begin(), flat.end(), data);
+    }
+    renderBuffer->Unmap();
+  }
+}
+
